---
interface Props {
  title: string;
  active?: string;
  image?: string;
}

const { title, active, image } = Astro.props;
const ogImage = new URL(image ?? '/images/bhairav1.jpg', Astro.site).href;
import Analytics from '@vercel/analytics/astro';

const nav = [
  { label: 'About', href: '/' },
  { label: 'Work', href: '/work' },
  { label: 'Projects', href: '/projects' },
  { label: 'Writing', href: '/blogs' },
  { label: 'Research', href: '/research' },
  { label: 'Notes', href: '/notes' },
  { label: 'Contact', href: '/#contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content="Gagan P — AI engineer at Rowboat Labs (YC S24). I build machine learning systems and write about ML, tech, and whatever grabs my curiosity." />
    <meta name="author" content="Gagan P" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://gaganp.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Gagan P — AI engineer at Rowboat Labs (YC S24). I build machine learning systems and write about ML, tech, and whatever grabs my curiosity." />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <slot name="head" />

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      const theme = localStorage.getItem('theme') ?? 'light';
      document.documentElement.classList.toggle('dark', theme === 'dark');

      // Direction class for swipe page transitions (set before render)
      const vtDir = sessionStorage.getItem('vt-dir');
      if (vtDir) {
        document.documentElement.classList.add('vt-' + vtDir);
        sessionStorage.removeItem('vt-dir');
      }
    </script>
  </head>
  <body class="bg-white dark:bg-[#0b0b0b] text-neutral-900 dark:text-neutral-200 antialiased min-h-screen">
    <div class="mx-auto max-w-2xl px-6 pt-10 sm:pt-16 pb-24">
      <nav class="flex flex-row flex-wrap items-baseline gap-x-5 gap-y-2 text-sm sm:text-[15px] mb-12 sm:mb-16">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-item relative w-fit transition-colors duration-150',
              active === item.label
                ? 'nav-active text-neutral-900 dark:text-neutral-100'
                : 'text-neutral-500 dark:text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-200',
            ]}
          >
            {item.label}
          </a>
        ))}
        <button
          id="theme-toggle"
          aria-label="Toggle theme"
          class="sm:ml-auto self-center text-neutral-400 dark:text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-200 transition-colors duration-150"
        >
          <!-- moon — shown in light mode, switches to dark -->
          <svg class="w-3.5 h-3.5 dark:hidden relative -top-px sm:top-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <!-- sun — shown in dark mode, switches to light -->
          <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </button>
      </nav>

      <main class="w-full min-w-0">
        <slot />
      </main>
    </div>

    <Analytics />

    <script>
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        // snap instantly: suspend color transitions for the swap
        document.documentElement.classList.add('no-transitions');
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        requestAnimationFrame(() => requestAnimationFrame(() => {
          document.documentElement.classList.remove('no-transitions');
        }));
      });

      // Flash the contact line when navigating to #contact
      function flashContact() {
        const el = document.getElementById('contact');
        if (!el) return;
        el.classList.remove('contact-flash');
        void el.offsetWidth;
        el.classList.add('contact-flash');
        el.addEventListener('animationend', () => el.classList.remove('contact-flash'), { once: true });
      }
      if (location.hash === '#contact') flashContact();
      document.querySelectorAll('a[href$="#contact"]').forEach((a) =>
        a.addEventListener('click', flashContact)
      );

      // Mobile: swipe left/right to move between pages in nav order.
      // Inside a blog post, either direction returns to the Writing tab.
      const swipePages = ['/', '/work', '/projects', '/blogs', '/research', '/notes'];
      const path = location.pathname.replace(/\/+$/, '') || '/';
      const pageIndex = swipePages.indexOf(path);
      const isBlogPost = path.startsWith('/blogs/');
      if (pageIndex !== -1 || isBlogPost) {
        let startX = 0, startY = 0, tracking = false;
        document.addEventListener('touchstart', (e) => {
          tracking = window.innerWidth < 640 && e.touches.length === 1;
          if (!tracking) return;
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
          // ignore swipes that start inside horizontally scrollable content
          let el = e.target instanceof Element ? e.target : null;
          while (el && el !== document.body) {
            if (el.scrollWidth > el.clientWidth + 1) { tracking = false; return; }
            el = el.parentElement;
          }
        }, { passive: true });
        document.addEventListener('touchend', (e) => {
          if (!tracking) return;
          const dx = e.changedTouches[0].clientX - startX;
          const dy = e.changedTouches[0].clientY - startY;
          if (Math.abs(dx) < 70 || Math.abs(dy) > Math.abs(dx) * 0.6) return;
          const dir = dx < 0 ? 'left' : 'right';
          let target = null;
          if (isBlogPost) {
            target = '/blogs';
          } else {
            const next = pageIndex + (dir === 'left' ? 1 : -1);
            if (next >= 0 && next < swipePages.length) target = swipePages[next];
          }
          if (target) {
            sessionStorage.setItem('vt-dir', dir);
            location.href = target;
          }
        }, { passive: true });
      }
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  body, a, button {
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .no-transitions, .no-transitions * {
    transition: none !important;
  }

  /* Active nav marker — thin underline */
  .nav-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.3em;
    height: 1px;
    background: currentColor;
  }

  /* Prose link style — dotted underline like the inspo */
  .link {
    color: inherit;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: rgb(163 163 163);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .link:hover {
    text-decoration-style: solid;
    text-decoration-color: currentColor;
  }
  .dark .link {
    text-decoration-color: rgb(82 82 82);
  }
  .dark .link:hover {
    text-decoration-color: currentColor;
  }

  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: rgba(0, 0, 0, 0.1); border-radius: 4px; }
  .dark ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); }

  ::selection {
    background: rgba(0, 0, 0, 0.08);
  }
  .dark ::selection {
    background: rgba(255, 255, 255, 0.15);
  }

  /* Cross-document slide transition for swipe navigation */
  @view-transition {
    navigation: auto;
  }
  @keyframes vt-out-left { to { transform: translateX(-100%); } }
  @keyframes vt-in-right { from { transform: translateX(100%); } }
  @keyframes vt-out-right { to { transform: translateX(100%); } }
  @keyframes vt-in-left { from { transform: translateX(-100%); } }
  html.vt-left::view-transition-old(root) { animation: vt-out-left 0.3s ease both; }
  html.vt-left::view-transition-new(root) { animation: vt-in-right 0.3s ease both; }
  html.vt-right::view-transition-old(root) { animation: vt-out-right 0.3s ease both; }
  html.vt-right::view-transition-new(root) { animation: vt-in-left 0.3s ease both; }

  /* Contact line flash on #contact navigation */
  .contact-flash {
    animation: contact-flash 2s ease;
    border-radius: 4px;
  }
  @keyframes contact-flash {
    0% { background: transparent; }
    15%, 60% { background: rgba(253, 224, 71, 0.35); }
    100% { background: transparent; }
  }
  .dark .contact-flash {
    animation-name: contact-flash-dark;
  }
  @keyframes contact-flash-dark {
    0% { background: transparent; }
    15%, 60% { background: rgba(253, 224, 71, 0.14); }
    100% { background: transparent; }
  }
</style>
