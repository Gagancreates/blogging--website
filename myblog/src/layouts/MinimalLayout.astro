---
interface Props {
  title: string;
  active?: string;
  image?: string;
}

const { title, active, image } = Astro.props;
const ogImage = new URL(image ?? '/images/bhairav1.jpg', Astro.site).href;
import Analytics from '@vercel/analytics/astro';

const nav = [
  { label: 'About', href: '/' },
  { label: 'Work', href: '/work' },
  { label: 'Projects', href: '/projects' },
  { label: 'Writing', href: '/blogs' },
  { label: 'Research', href: '/research' },
  { label: 'Notes', href: '/notes' },
  { label: 'Contact', href: '/#contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content="Gagan P — AI engineer at Rowboat Labs (YC S24). I build machine learning systems and write about ML, tech, and whatever grabs my curiosity." />
    <meta name="author" content="Gagan P" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://gaganp.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Gagan P — AI engineer at Rowboat Labs (YC S24). I build machine learning systems and write about ML, tech, and whatever grabs my curiosity." />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      const theme = localStorage.getItem('theme') ?? 'light';
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body class="bg-white dark:bg-[#0b0b0b] text-neutral-900 dark:text-neutral-200 antialiased min-h-screen">
    <div class="mx-auto max-w-4xl px-6 pt-12 sm:pt-24 pb-24 flex flex-col sm:flex-row gap-10 sm:gap-20">
      <aside class="sm:w-28 shrink-0">
        <nav class="flex flex-row flex-wrap gap-x-6 gap-y-2 sm:flex-col sm:gap-y-3 sm:sticky sm:top-24 text-[15px]">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'nav-item relative w-fit transition-colors duration-150',
                active === item.label
                  ? 'nav-active text-neutral-900 dark:text-neutral-100'
                  : 'text-neutral-500 dark:text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-200',
              ]}
            >
              {item.label}
            </a>
          ))}
          <button
            id="theme-toggle"
            aria-label="Toggle theme"
            class="mt-1 sm:mt-6 w-fit text-neutral-400 dark:text-neutral-600 hover:text-neutral-900 dark:hover:text-neutral-300 transition-colors duration-150 text-[13px]"
          >
            <span class="dark:hidden">dark</span>
            <span class="hidden dark:inline">light</span>
          </button>
        </nav>
      </aside>

      <main class="w-full max-w-xl min-w-0">
        <slot />
      </main>
    </div>

    <Analytics />

    <script>
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-feature-settings: 'cv11';
  }

  body, a, button {
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  /* Active nav marker — thin bar to the left, desktop only */
  @media (min-width: 640px) {
    .nav-active::before {
      content: '';
      position: absolute;
      left: -0.75rem;
      top: 0.2em;
      bottom: 0.2em;
      width: 1px;
      background: currentColor;
    }
  }

  /* Prose link style — dotted underline like the inspo */
  .link {
    color: inherit;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: rgb(163 163 163);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .link:hover {
    text-decoration-style: solid;
    text-decoration-color: currentColor;
  }
  .dark .link {
    text-decoration-color: rgb(82 82 82);
  }
  .dark .link:hover {
    text-decoration-color: currentColor;
  }

  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: rgba(0, 0, 0, 0.1); border-radius: 4px; }
  .dark ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); }

  ::selection {
    background: rgba(0, 0, 0, 0.08);
  }
  .dark ::selection {
    background: rgba(255, 255, 255, 0.15);
  }
</style>
