---
import MinimalLayout from './MinimalLayout.astro';

interface Props {
  title: string;
  heading: string;
  date?: string;
  active?: string;
  math?: boolean;
  image?: string;
}

const { title, heading, date, active = 'Writing', math = false, image } = Astro.props;
---

<MinimalLayout title={title} active={active} image={image}>
  <Fragment slot="head">
    {math && (
      <>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous" />
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js" integrity="sha384-XjKyOOlGwcjNTAIQHIpgOno0Hl1YQqzUOEleOLALmuqehneUG+vnGctmUb0ZY0l8" crossorigin="anonymous"></script>
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" integrity="sha384-+VBxd3r6XgURycqtZ117nYw44OOcIax56Z4dCRWbxyPt0Koah1uHoK0o4+/RRE05" crossorigin="anonymous" onload="renderMathInElement(document.body, { delimiters: [ {left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false} ], throwOnError: false });"></script>
      </>
    )}
  </Fragment>

  <article>
    <h1 class="text-lg sm:text-2xl font-medium text-neutral-900 dark:text-neutral-100 leading-snug">
      {heading}
    </h1>
    {date && (
      <p class="mt-2 text-[13px] text-neutral-400 dark:text-neutral-600">{date}</p>
    )}
    <div class="post mt-10">
      <slot />
    </div>
  </article>
</MinimalLayout>

<style is:global>
  .post {
    font-size: 14px;
    line-height: 1.8;
    color: rgb(38 38 38);
  }
  .dark .post {
    color: rgb(212 212 212);
  }
  @media (min-width: 640px) {
    .post { font-size: 16px; }
  }

  .post > div > * + *,
  .post > * + * {
    margin-top: 1.25rem;
  }

  .post h2 {
    font-size: 17px;
    font-weight: 500;
    color: rgb(23 23 23);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .post h3 {
    font-size: 16px;
    font-weight: 500;
    color: rgb(23 23 23);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .post h4 {
    font-size: 15px;
    font-weight: 500;
    color: rgb(23 23 23);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .dark .post h2, .dark .post h3, .dark .post h4 {
    color: rgb(245 245 245);
  }

  .post a {
    color: inherit;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: rgb(163 163 163);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .post a:hover {
    text-decoration-style: solid;
    text-decoration-color: currentColor;
  }
  .dark .post a {
    text-decoration-color: rgb(82 82 82);
  }
  .dark .post a:hover {
    text-decoration-color: currentColor;
  }

  .post ul, .post ol {
    padding-left: 1.25rem;
  }
  .post ul { list-style-type: disc; }
  .post ol { list-style-type: decimal; }
  .post li { margin-top: 0.5rem; }
  .post li::marker { color: rgb(163 163 163); }
  .dark .post li::marker { color: rgb(82 82 82); }

  .post pre {
    background: rgb(250 250 250);
    border: 1px solid rgb(229 229 229);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.6;
  }
  .dark .post pre {
    background: rgb(23 23 23);
    border-color: rgb(38 38 38);
  }
  .post code {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 13px;
  }
  .post :not(pre) > code {
    background: rgb(245 245 245);
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
  }
  .dark .post :not(pre) > code {
    background: rgb(38 38 38);
  }

  .post blockquote {
    border-left: 2px solid rgb(212 212 212);
    padding-left: 1rem;
    font-style: italic;
    color: rgb(115 115 115);
  }
  .dark .post blockquote {
    border-color: rgb(64 64 64);
    color: rgb(163 163 163);
  }

  .post table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .post th, .post td {
    border: 1px solid rgb(229 229 229);
    padding: 0.5rem 1rem;
    text-align: left;
  }
  .post th {
    background: rgb(250 250 250);
    font-weight: 500;
  }
  .dark .post th, .dark .post td {
    border-color: rgb(38 38 38);
  }
  .dark .post th {
    background: rgb(23 23 23);
  }

  .post img {
    max-width: 100%;
    border-radius: 0.5rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .post hr {
    border: none;
    border-top: 1px solid rgb(229 229 229);
    margin: 2.5rem 0;
  }
  .dark .post hr {
    border-top-color: rgb(38 38 38);
  }

  .post .katex { font-size: 1.05em; }
  .post .katex-display { overflow-x: auto; overflow-y: hidden; padding: 0.25rem 0; }
</style>
