---
import MinimalLayout from '../../layouts/MinimalLayout.astro';

const sections = [
  {
    title: 'Machine Learning',
    blogs: [
      {
        title: 'Introduction to RNNs',
        excerpt: 'From why we need memory in neural networks to the math of Backpropagation Through Time.',
        date: '2026-01-01',
        href: '/blogs/RNNs',
      },
      {
        title: 'K-Nearest Neighbors (ML 101)',
        excerpt: 'Learn about KNN and implement it on the iris dataset.',
        date: '2025-07-10',
        href: 'https://sheer-castanet-7f7.notion.site/K-Nearest-Neighbors-ML-101-25371143c5dc80ccb7d8c01cab98e00f',
      },
      {
        title: 'Build a neural network for MNIST from scratch',
        excerpt: 'Classify handwritten digits from the MNIST dataset using only numpy.',
        date: '2025-06-10',
        href: 'https://sheer-castanet-7f7.notion.site/build-a-neural-network-for-mnist-from-scratch-23271143c5dc80158874fb6af1b34670',
      },
      {
        title: 'Build your first neural network from scratch',
        excerpt: 'Implement a neural network without PyTorch, TensorFlow, or any other library.',
        date: '2025-05-14',
        href: 'https://sheer-castanet-7f7.notion.site/build-your-first-neural-network-from-scratch-22b71143c5dc80fd8681fbaae5eac94d',
      },
      {
        title: 'Introduction to Neural Networks',
        excerpt: 'How a neural network works and how it was developed.',
        date: '2025-04-14',
        href: 'https://sheer-castanet-7f7.notion.site/Introduction-to-Neural-Networks-1de71143c5dc80de9669dc93448c36d4?pvs=4',
      },
      {
        title: 'Solving the Problem of Overfitting: Regularisation',
        excerpt: 'Understanding overfitting and the types of regularisation that fix it.',
        date: '2025-03-22',
        href: 'https://sheer-castanet-7f7.notion.site/Solving-the-Problem-of-Overfitting-Regularisation-1c471143c5dc80bcb241c5101a4dfdd4?pvs=4',
      },
      {
        title: 'Gradient Descent: From Zero to Hero',
        excerpt: 'Gradient descent from the basics, with the math and visualisations.',
        date: '2024-02-16',
        href: 'https://sheer-castanet-7f7.notion.site/Gradient-Descent-Zero-to-Hero-1ba71143c5dc806486ebdc0f936c7c93',
      },
    ],
  },
  {
    title: 'Writings',
    blogs: [
      {
        title: "I Built a Startup at 18. Here's the Full Story.",
        excerpt: 'Six months of building zTutor — the inspiration, the pivots, the near-misses, and why I decided to stop.',
        date: '2026-06-21',
        href: '/blogs/i-built-a-startup-at-18',
      },
      {
        title: 'How I Use Claude Code',
        excerpt: 'My three-phase workflow for using AI coding assistants without creating a mess.',
        date: '2025-12-06',
        href: '/blogs/how-i-use-claude-code',
      },
      {
        title: 'Education needs a change',
        excerpt: "Why I'm building zTutor and the current scenario of modern education.",
        date: '2025-12-03',
        href: '/blogs/education-needs-change',
      },
    ],
  },
];

function formatDate(dateString: string) {
  return new Date(dateString).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<MinimalLayout title="Writing | Gagan P" active="Writing">
  <div class="space-y-12">
    {sections.map((section) => (
      <div>
        <p class="mb-6 text-neutral-400 dark:text-neutral-600 text-[13px] uppercase tracking-wide">{section.title}</p>
        <div class="space-y-7">
          {section.blogs.map((blog) => (
            <div>
              <div class="flex items-baseline justify-between gap-4">
                <a
                  href={blog.href}
                  target={blog.href.startsWith('http') ? '_blank' : undefined}
                  rel={blog.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="link text-[15px] sm:text-base text-neutral-900 dark:text-neutral-100"
                >
                  {blog.title}
                </a>
                <span class="text-[13px] text-neutral-400 dark:text-neutral-600 whitespace-nowrap">
                  {formatDate(blog.date)}
                </span>
              </div>
              <p class="mt-1 text-[15px] sm:text-base leading-[1.7] text-neutral-500 dark:text-neutral-500">
                {blog.excerpt}
              </p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</MinimalLayout>
