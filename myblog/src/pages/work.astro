---
import MinimalLayout from '../layouts/MinimalLayout.astro';

const experience = [
  {
    role: 'AI Engineer',
    org: 'Rowboat Labs (YC S24)',
    date: 'Present',
    description: null,
    href: 'https://rowboatlabs.com',
    logo: '/images/rowboat_labs_logo.jpg',
  },
  {
    role: 'Founder',
    org: 'zTutor',
    date: 'June 2025 — April 2026',
    description: 'AI-powered educational video platform from 0→1. 2000+ videos generated, backed by 3F Venture Capital.',
    href: 'https://ztutor.app',
    logo: '/images/ztutor-logo.png',
  },
  {
    role: 'Subject Matter Expert',
    org: 'PESU I/O',
    date: 'September 2025 — December 2025',
    description: 'Taught a course on foundations of neural networks and deep learning to ~50 students.',
    href: 'https://pesu.io',
    logo: '/images/pesuio.png',
  },
  {
    role: 'Summer Intern',
    org: 'Center for Robotics, Automation and Intelligent Systems',
    date: 'June 2025 — August 2025',
    description: 'Implemented RL algorithms for robotic control and autonomous navigation.',
    href: null,
    logo: '/images/crais.jpeg',
  },
];
---

<MinimalLayout title="Work | Gagan P" active="Work">
  <div class="space-y-10 sm:space-y-12">
    {experience.map((item) => (
      <div class="flex gap-4 sm:gap-5 items-start">
        <img
          src={item.logo}
          alt={`${item.org} logo`}
          class="w-10 h-10 shrink-0 rounded-md object-cover bg-neutral-100 dark:bg-neutral-900 mt-0.5 shadow-[0_2px_8px_rgba(0,0,0,0.12)] dark:shadow-[0_2px_8px_rgba(255,255,255,0.08)]"
          loading="lazy"
        />
        <div class="min-w-0">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-0.5 sm:gap-4">
            <h2 class="text-[15px] sm:text-base text-neutral-900 dark:text-neutral-100">
              {item.role} ·
              {item.href ? (
                <a href={item.href} target="_blank" rel="noopener noreferrer" class="link">{item.org}</a>
              ) : (
                <span>{item.org}</span>
              )}
            </h2>
            <span class="text-[13px] text-neutral-400 dark:text-neutral-600 whitespace-nowrap">
              {item.date}
            </span>
          </div>
          {item.description && (
            <p class="mt-1.5 text-[15px] sm:text-base leading-[1.7] text-neutral-500 dark:text-neutral-500">
              {item.description}
            </p>
          )}
        </div>
      </div>
    ))}
  </div>
</MinimalLayout>
