---
import MinimalLayout from '../../layouts/MinimalLayout.astro';

const semesters = [
  {
    title: '3rd Semester',
    subjects: [
      {
        name: 'Data Structures and Algorithms',
        note: 'only the important code + theory',
        units: [
          {
            title: 'Unit 1: Introduction to Data Structures',
            topics: 'Arrays, linked lists, stacks and their implementation.',
            link: '/notes/3rd_sem/dsa/unit1',
          },
          {
            title: 'Unit 2: Queues and BST',
            topics: 'Types of queues, binary trees, binary search trees.',
            link: '/notes/3rd_sem/dsa/unit2',
          },
          {
            title: 'Unit 3: Graphs and Trees',
            topics: 'BST implementation, trees, graphs, BFS and DFS.',
            link: '/notes/3rd_sem/dsa/unit3',
          },
          {
            title: 'Unit 4: Advanced Data Structures',
            topics: 'Hash tables, tries and suffix trees.',
            link: '/notes/3rd_sem/dsa/unit4',
          },
        ],
      },
    ],
  },
];
---

<MinimalLayout title="Notes | Gagan P" active="Notes">
  <div class="space-y-12">
    {semesters.map((semester) => (
      <div>
        <p class="mb-6 text-neutral-400 dark:text-neutral-600 text-[13px] uppercase tracking-wide">{semester.title}</p>
        {semester.subjects.map((subject) => (
          <div>
            <p class="text-sm sm:text-base text-neutral-900 dark:text-neutral-100">
              {subject.name}
              <span class="text-neutral-400 dark:text-neutral-600 text-[13px]"> — {subject.note}</span>
            </p>
            <div class="mt-6 space-y-7">
              {subject.units.map((unit) => (
                <div>
                  <a href={unit.link} class="link text-sm sm:text-base text-neutral-900 dark:text-neutral-100">
                    {unit.title}
                  </a>
                  <p class="mt-1 text-sm sm:text-base leading-[1.7] text-neutral-500 dark:text-neutral-500">
                    {unit.topics}
                  </p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    ))}

    <p class="text-sm sm:text-base text-neutral-500 dark:text-neutral-500">
      More semesters will be added as I progress through my coursework.
    </p>
  </div>
</MinimalLayout>
